# Copy this file to .env and fill in your own values.
# Get a client ID from https://developer.spotify.com/dashboard (PKCE flow — no client secret needed).

SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# SPOTIFY_SCOPES is left unset here on purpose — the default in config.py is
# the source of truth for which scopes are requested. Only set this to
# override it locally.
