# Copy this file to .env and fill in your own values.
# Get a client ID from https://developer.spotify.com/dashboard (PKCE flow — no client secret needed).

SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# SPOTIFY_SCOPES is left unset here on purpose — the default in config.py is
# the source of truth for which scopes are requested. Only set this to
# override it locally.

# Secret that signs the access tokens this server issues. At least 32 bytes.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SIGNING_KEY=

# Key that encrypts users' Spotify tokens in the database. Losing it means
# everyone has to log in to Spotify again. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
